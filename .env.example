# Chain RPC
BSC_RPC_URL=
BSC_WSS_URL=
ROBINHOOD_RPC_URL=
ROBINHOOD_WSS_URL=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PostgreSQL (optional; leave empty to disable persistence)
DATABASE_URL=postgresql://radar:radar_dev_only@localhost:5432/radar

# Runtime
POLL_INTERVAL_SECONDS=30
MAX_CATCHUP_BLOCKS=20
RPC_RATE_LIMIT_COOLDOWN_SECONDS=300
RPC_MAX_BACKOFF_SECONDS=60
LOG_LEVEL=INFO
MARKET_DATA_ENABLED=true
SECURITY_DATA_ENABLED=true
MARKET_DATA_TIMEOUT_SECONDS=12
AGGREGATION_WINDOW_MINUTES=60
MIN_ALERT_SCORE=60
ALERT_EVENT_TYPES=BUY,SELL,SWAP
